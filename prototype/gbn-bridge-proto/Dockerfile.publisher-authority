FROM rust:1-bookworm AS builder
WORKDIR /workspace
RUN apt-get update \
  && apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.toml
COPY src src
COPY crates crates

RUN cargo build --release --package gbn-bridge-cli --bin publisher-authority

FROM debian:bookworm-slim
ARG VERITAS_BUILD_VERSION=unknown
ARG VERITAS_BUILD_SOURCE=unknown
ARG VERITAS_BUILD_CREATED=unknown
LABEL org.opencontainers.image.title="veritas-publisher-authority" \
  org.opencontainers.image.version="${VERITAS_BUILD_VERSION}" \
  org.opencontainers.image.revision="${VERITAS_BUILD_SOURCE}" \
  org.opencontainers.image.created="${VERITAS_BUILD_CREATED}" \
  veritas.component="publisher-authority" \
  veritas.build.version="${VERITAS_BUILD_VERSION}"
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/target/release/publisher-authority /usr/local/bin/publisher-authority
ENV VERITAS_CONDUIT_BUILD_VERSION="${VERITAS_BUILD_VERSION}" \
  VERITAS_CONDUIT_BUILD_SOURCE="${VERITAS_BUILD_SOURCE}" \
  VERITAS_CONDUIT_BUILD_CREATED="${VERITAS_BUILD_CREATED}"

EXPOSE 8080

CMD ["/usr/local/bin/publisher-authority"]
